[Unit]
Description=BioVision liveness watchdog
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=BIOVISION_APP_DIR=/opt/biovision/current
Environment=BIOVISION_HEALTH_URL=http://127.0.0.1:3000/health/live
Environment=BIOVISION_WATCHDOG_STATE_DIR=/var/lib/biovision-watchdog
ExecStart=/bin/sh /opt/biovision/current/ops/watchdog.sh
StateDirectory=biovision-watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
