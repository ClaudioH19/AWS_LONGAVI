# Puerto expuesto en el host
HOST_PORT=3000
# Publicación requerida cuando IAGRO consume la estación desde otro host.
# Restringir HOST_PORT por firewall cuando el servidor IAGRO tenga IP estable.
BIND_ADDRESS=0.0.0.0
DATA_VOLUME_NAME=aws_longavi_weather-data
# Sólo para una VPS nueva sin weather_data.db: crea una DB vacía con el esquema.
# No usar si se espera recuperar datos históricos desde una copia existente.
INITIALIZE_EMPTY_DATABASE=false

# Opcional: red Docker externa de Nginx Proxy Manager, por ejemplo npm_default.
# Dejar vacío si NPM no es un contenedor en la misma VPS/red Docker.
PROXY_DOCKER_NETWORK=

# Recursos del contenedor (ajustar a la VPS)
MEMORY_LIMIT=512m
CPU_LIMIT=1.0

# Operación
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=65536
MAX_RANGE_LIMIT=5000
MAX_EXPORT_LIMIT=50000
MIN_FREE_DISK_BYTES=134217728
STATION_STALE_AFTER_SECONDS=10800
SQLITE_JOURNAL_MODE=DELETE
TRUST_PROXY_COUNT=1

# Opcional: IP pública/CIDR estable de la estación si se dispone de ella.
# Dejar vacío para estaciones con IP dinámica. Ejemplo: 203.0.113.42/32
INGEST_ALLOWED_IPS=

# Solo para diagnóstico local; no habilitar en Internet.
ENABLE_DIAGNOSTIC_ROUTES=false

