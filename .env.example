# Puerto expuesto en el host
HOST_PORT=3000
# Seguro por defecto para Nginx/Caddy ejecutado en el host.
# Usar 0.0.0.0 sólo con firewall y un proxy en otro contenedor.
BIND_ADDRESS=127.0.0.1
DATA_VOLUME_NAME=aws_longavi_weather-data

# Recursos del contenedor (ajustar a la VPS)
MEMORY_LIMIT=512m
CPU_LIMIT=1.0

# Operación
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=65536
MAX_RANGE_LIMIT=5000
MAX_EXPORT_LIMIT=50000
MIN_FREE_DISK_BYTES=134217728
STATION_STALE_AFTER_SECONDS=10800
SQLITE_JOURNAL_MODE=DELETE
TRUST_PROXY_COUNT=1

# Opcional: IP pública/CIDR estable de la estación si se dispone de ella.
# Dejar vacío para estaciones con IP dinámica. Ejemplo: 203.0.113.42/32
INGEST_ALLOWED_IPS=

# Solo para diagnóstico local; no habilitar en Internet.
ENABLE_DIAGNOSTIC_ROUTES=false

