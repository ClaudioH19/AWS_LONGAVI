# Puerto expuesto en el host
HOST_PORT=3000
# 0.0.0.0 permite acceso directo y proxies ejecutados en otro contenedor.
# Usar 127.0.0.1 sólo cuando el proxy se ejecuta directamente en el host.
BIND_ADDRESS=0.0.0.0
DATA_VOLUME_NAME=aws_longavi_weather-data

# Recursos del contenedor (ajustar a la VPS)
MEMORY_LIMIT=512m
CPU_LIMIT=1.0

# Operación
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=65536
MAX_RANGE_LIMIT=5000
MAX_EXPORT_LIMIT=50000
MIN_FREE_DISK_BYTES=134217728
STATION_STALE_AFTER_SECONDS=10800
SQLITE_JOURNAL_MODE=DELETE
TRUST_PROXY_COUNT=1

# Dejar vacío si el proxy restringe POST /weather por IP.
# Si se define, la estación debe enviar X-Weather-Key.
INGEST_API_KEY=

# Solo para diagnóstico local; no habilitar en Internet.
ENABLE_DIAGNOSTIC_ROUTES=false

